# Build trees
build/
build-*/
cmake-build-*/
CMakeUserPresets.json

# Compiled objects and binaries
*.o
*.obj
*.a
*.so
*.so.*
*.dylib
*.dll
*.exe

# Sweep output. Everything under experiments/results is generated except the
# committed canonical summary, which the report and CI build from.
experiments/results/*
!experiments/results/.gitkeep
!experiments/results/summary.csv
!experiments/results/session_manifest.json

# Report intermediates. The PDFs themselves are generated by make report and
# are attached to the release rather than tracked.
report/build/
report_debug/build/
report_for_me/build/
report/figures/*.pdf
report/figures/*.png
report/tables/*.tex
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.toc
*.lof
*.lot
*.synctex.gz
*.run.xml
*.bcf

# Python
__pycache__/
*.py[cod]
.venv/
.ruff_cache/
.pytest_cache/

# Editor and OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Local agent settings are committed deliberately (attribution is disabled
# there); nothing else under .claude is.
.claude/*
!.claude/settings.local.json
