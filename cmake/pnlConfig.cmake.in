# SPDX-License-Identifier: MIT
# Package configuration for pnl, expanded by configure_package_config_file.
#
# Order matters here. Everything pnl_core links PUBLIC is named as an imported
# target inside pnlTargets.cmake, and CMake validates those names as it reads
# that file, so each one has to be found before the include() at the bottom
# rather than after it.
#
# Threads is unconditional because pnl_core always links it. The other three are
# guarded on what this build actually enabled, recorded at configure time, so a
# consumer of a build without MPI never looks for MPI and never fails for the
# want of something the library it has does not use.

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(Threads)

if(@PNL_WITH_OPENMP@)
    find_dependency(OpenMP COMPONENTS CXX)
endif()

if(@PNL_WITH_MPI@)
    find_dependency(MPI COMPONENTS CXX)
endif()

if(@PNL_WITH_CUDA@)
    find_dependency(CUDAToolkit)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/pnlTargets.cmake")

check_required_components(pnl)
