#pragma once

/// \file version.hpp
/// The library's version, as three integers and as the string they spell.
///
/// Generated by CMake from `cmake/version.hpp.in`. Do not edit this file; edit
/// the template.
///
/// It is generated into the build tree and never into the source tree, and that
/// is not a matter of tidiness. The commit stamp every result row carries is
/// computed from a `git status --porcelain` narrowed to `CMakeLists.txt`,
/// `cmake`, `include`, `src`, `tests`, `benchmarks`, `scripts` and the
/// `Makefile`, so a generated header under `include/` would appear untracked on
/// every configure and stamp every measured row `.dirty`. That is exactly the
/// fault PROV-01 in the engineering log records and phase A8a repaired, and it
/// is not being re created here.
///
/// The version reads 1.0.0 and stays there for the whole of the 1.1.0 work.
/// Phase E5 bumps the `project()` call and this header follows it, so that every
/// intermediate build is honestly labelled as pre release work on top of the
/// released 1.0.0 rather than claiming a version that has not shipped.

#define PNL_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define PNL_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define PNL_VERSION_PATCH @PROJECT_VERSION_PATCH@
#define PNL_VERSION_STRING "@PROJECT_VERSION@"

namespace pnl {

/// The version as three integers.
///
/// The members are not named `major`, `minor` and `patch` because glibc's
/// `<sys/sysmacros.h>` defines the first two as function like macros, and a
/// consumer who reached this header after that one would get a diagnostic
/// pointing at a line that looks correct.
struct VersionTriple {
    int major_version;
    int minor_version;
    int patch_version;
};

/// The version this library was built as.
inline constexpr VersionTriple VERSION{PNL_VERSION_MAJOR, PNL_VERSION_MINOR, PNL_VERSION_PATCH};

/// The same version as the string `pnlConfigVersion.cmake` and `CHANGELOG.md`
/// carry. `test_version` asserts that the two spellings agree, because they are
/// generated from one source and a mismatch would mean the substitution broke.
inline constexpr const char* VERSION_STRING = PNL_VERSION_STRING;

}  // namespace pnl
